{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/components/blocks/*": ["./packages/loveui-pro/components/blocks/*"],
      "@/components/ui/chart": ["./packages/loveui-pro/components/ui/chart"],
      "@/components/ui/recharts-chart": ["./packages/loveui-pro/registry/default/ui/chart"],
      "@tabler/icons-react": ["./components/ui/tabler-icons"],
      "love-ui/icons": ["./packages/loveui/registry/default/icons/src"],
      "love-ui/logos": ["./components/ui/love-ui-logos"],
      "@/registry/default/blocks/stats7/*": ["./packages/loveui-pro/registry/default/blocks/stats7/*"],
      "@/registry/default/blocks/stats8/*": ["./packages/loveui-pro/registry/default/blocks/stats8/*"],
      "@/registry/default/blocks/stats10/*": ["./packages/loveui-pro/registry/default/blocks/stats10/*"],
      "@/registry/default/blocks/stats12/*": ["./packages/loveui-pro/registry/default/blocks/stats12/*"],
      "@/registry/default/ui/chart": ["./packages/loveui-pro/registry/default/ui/chart"],
      "@/*": ["./*"],
      "collections/*": ["./.source/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "instrumentation-client.ts",
    "proxy.ts",
    "source.config.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "registry/**/*.ts",
    "registry/**/*.tsx",
    "packages/loveui-pro/app/**/*.ts",
    "packages/loveui-pro/app/**/*.tsx",
    "packages/loveui-pro/components/**/*.ts",
    "packages/loveui-pro/components/**/*.tsx",
    "packages/loveui-pro/lib/**/*.ts",
    "packages/loveui-pro/lib/**/*.tsx",
    "packages/loveui-pro/registry/**/*.ts",
    "packages/loveui-pro/registry/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/cache/**",
    "components/ui/code-block/src/components/code-block/blocks/**",
    "components/ui/code-block/src/components/code-block/client/**",
    "components/ui/code-block/src/components/code-block/mdx/**",
    "components/ui/code-block/src/components/ui/**",
    "components/ui/code-block/src/stores/**",
    "components/ui/code-block/src/utils/sugar-high/**",
    "registry/default/examples/**",
    "packages/*-pro",
    "packages/loveui/node_modules",
    "packages/loveui/dist",
    "packages/loveui/packages",
    "packages/loveui/src",
    "packages/loveui/test",
    "packages/loveui/tsup.config.ts",
    "packages/loveui/vitest.config.ts",
    "packages/loveui/registry"
  ]
}
