OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Local Docker Postgres by default. In production, set this to the Railway
# Postgres public TCP proxy URL.
DATABASE_URL=postgres://loveui:loveui@127.0.0.1:5433/loveui

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

RESEND_API_KEY=
RESEND_FROM_EMAIL=

# PostHog is only initialized in production and never on localhost/LAN hosts.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_INGEST_PATH=/_lui
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
POSTHOG_API_HOST=https://us.i.posthog.com
POSTHOG_ASSETS_HOST=https://us-assets.i.posthog.com

STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

LOVEUI_PRO_GITHUB_TOKEN=
pro_enabled=true
